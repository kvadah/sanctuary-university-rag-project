# KnowledgeHub AI - Environment Configuration

# Project Metadata
PROJECT_NAME="KnowledgeHub AI"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=knowledgehub

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""

# Cache & Message Broker (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=knowledgehub-documents
MINIO_SECURE=false

# Authentication & Security
SECRET_KEY="super-secret-key-change-in-production-knowledgehub-ai"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Providers
# LLM provider: "gemini" (Google AI Studio free tier — default) or "openai".
LLM_PROVIDER="gemini"
# Google AI Studio key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Gemini defaults (gemini-embedding-001 → 3072-dim). For OpenAI, use e.g.
# text-embedding-3-small (1536) + gpt-4o-mini and set EMBEDDING_DIM to match.
DEFAULT_EMBEDDING_MODEL="gemini-embedding-001"
DEFAULT_LLM_MODEL="gemini-2.5-flash"
EMBEDDING_DIM=3072

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"
